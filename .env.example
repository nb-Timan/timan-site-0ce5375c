# Public browser configuration for Vercel. VITE_ values are embedded in the
# browser bundle; never put service-role keys, SMTP credentials, or API keys
# with write/admin access here.

# Required
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public integrations
VITE_GOOGLE_MAPS_API_KEY=
VITE_CARTO_BASEMAP_KEY=
VITE_N8N_CRM_CALENDAR_WEBHOOK_URL=

# Optional public site URL for generated QR links. Leave unset in Preview so
# the current Vercel preview origin is used automatically.
VITE_PORTAL_SITE_URL=
